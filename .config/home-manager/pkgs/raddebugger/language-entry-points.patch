+//- entry traps: skip the prologue. The first line row of a function covers its
+// opening line and the frame setup, so locals read garbage there; stop at the
+// first row on another line instead (falls back to the function start).
+internal U64
+d_post_prologue_voff_from_procedure(RDI_Parsed *rdi, RDI_Symbol *procedure)
+{
+  U64 first = rdi_first_voff_from_procedure(rdi, procedure);
+  U64 opl = rdi_opl_voff_from_procedure(rdi, procedure);
+  U64 result = first;
+  if(first != 0)
+  {
+    RDI_Unit *unit = rdi_unit_from_voff(rdi, first);
+    RDI_LineTable *line_table = rdi_line_table_from_unit(rdi, unit);
+    RDI_ParsedLineTable lines = {0};
+    rdi_parsed_from_line_table(rdi, line_table, &lines);
+    U64 idx = rdi_line_info_idx_from_voff(&lines, first);
+    if(idx < lines.count)
+    {
+      U32 first_line_num = lines.lines[idx].line_num;
+      for(U64 i = idx + 1; i < lines.count && lines.voffs[i] < opl; i += 1)
+      {
+        if(lines.lines[i].line_num != 0 && lines.lines[i].line_num != first_line_num)
+        {
+          result = lines.voffs[i];
+          break;
+        }
+      }
+    }
+  }
+  return result;
+}
