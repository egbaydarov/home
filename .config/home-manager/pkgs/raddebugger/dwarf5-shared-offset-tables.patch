+// Some producers (e.g. Go) emit one table shared by all units; a unit's base
+// attribute then points into the middle of it rather than at its first entry,
+// and indices are relative to that base.
+internal DW2_OffsetTable *
+dw2_offset_table_rebased(DW2_OffsetTable *dst, DW2_OffsetTable *src, U64 base_off)
+{
+  U64 skip = 0;
+  if(base_off > src->entries_off && src->entry_size != 0)
+  {
+    skip = Min((base_off - src->entries_off) / src->entry_size, src->entries_count);
+  }
+  *dst = *src;
+  dst->entries        = (U8 *)src->entries + skip*src->entry_size;
+  dst->entries_count -= skip;
+  dst->entries_off   += skip*src->entry_size;
+  return dst;
+}
